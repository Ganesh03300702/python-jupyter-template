import matplotlib.pyplot as plt

# Define x and y values
x = list(range(0, 11))
y = [i**2 for i in x]  # Squaring each x value

# Create the plot
plt.plot(x, y, marker='o', color='teal', linestyle='-')

# Customizations
plt.title('Square of Numbers from 0 to 10')
plt.xlabel('X Values')
plt.ylabel('Y = X Squared')
plt.grid(True)

# Show the plot
plt.show()

